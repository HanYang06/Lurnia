#
# Normalize line endings in the repository, independent of each contributor's
# local `core.autocrlf`. Without this, a machine with autocrlf=true checks files
# out as CRLF while .editorconfig declares LF, and every line-ending-aware hook
# and diff churns. See the mixed-line-ending hook in .pre-commit-config.yaml.

# Default: store LF in the repository, check out LF everywhere.
* text=auto eol=lf

# --- explicitly text, LF ---------------------------------------------------
*.py       text eol=lf
*.pyi      text eol=lf
*.toml     text eol=lf
*.lock     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.rs       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf

# --- Windows-specific scripts keep CRLF ------------------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# --- binary: never touch ------------------------------------------------
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.icns     binary
*.svg      text eol=lf
*.woff     binary
*.woff2    binary
*.ttf      binary
*.exe      binary
*.dll      binary
*.pyd      binary
*.so       binary
*.dylib    binary
*.zip      binary
*.db       binary
*.sqlite   binary
*.sqlite3  binary

# --- generated / vendored: keep out of language stats -------------------
uv.lock            linguist-generated=true
pnpm-lock.yaml     linguist-generated=true
Cargo.lock         linguist-generated=true
